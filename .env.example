# Copy to .env or set as environment variables. All values shown are the
# defaults the app already uses, so this file changes nothing by itself.
# Environment variables take precedence over values in this file, and an empty
# value means "not set". Booleans accept true/1/false/0 (case-insensitive); an
# unparseable value is logged as a warning and the default is used.

# yt-dlp format selector
YDL_FORMAT=bestvideo+bestaudio/best

# Set to an audio codec (aac, flac, mp3, m4a, opus, vorbis, wav) to extract audio;
# leave empty to use the format selector above. A request whose format field names a
# codec or container overrides both of these for that download: the request format
# selects the postprocessor, not the yt-dlp format selector.
YDL_EXTRACT_AUDIO_FORMAT=
YDL_EXTRACT_AUDIO_QUALITY=192

# Set to a video container (mp4, flv, webm, ogg, mkv, avi) to recode; leave empty to
# use the format selector above.
YDL_RECODE_VIDEO_FORMAT=

YDL_OUTPUT_TEMPLATE=/youtube-dl/%(title).200s [%(id)s].%(ext)s

# Optional yt-dlp download archive file (e.g. /youtube-dl/archive.txt)
# YDL_ARCHIVE_FILE=

# Optional HTTP proxy for yt-dlp requests and downloads (e.g. http://127.0.0.1:8118).
# Empty/unset means yt-dlp keeps its normal proxy discovery from the environment.
# YDL_PROXY=

# Optional cookie file for age-restricted/logged-in downloads (yt-dlp --cookies).
# Path as the operator writes it, inside the container -- credentials at rest, so
# it is only read when explicitly configured.
# YDL_COOKIE_FILE=

# Media options, all opt-in. These map to the yt-dlp flags of the same name
# (--write-sub, --sub-langs, --write-thumbnail, --embed-metadata): sidecar files
# and metadata, not embedding into the video. Anything beyond these belongs in a
# mounted yt-dlp config file.
# YDL_WRITE_SUBTITLES=False
# YDL_SUBTITLES_LANGS=            # comma-separated, e.g. en,es or all
# YDL_WRITE_THUMBNAIL=False
# YDL_EMBED_METADATA=False

# Set to True to skip videos that fail (deleted, region blocked, private) instead of
# ending the whole download, e.g. the rest of a playlist (same as yt-dlp
# --ignore-errors). Failures are still logged by yt-dlp.
# YDL_IGNORE_ERRORS=False

# Set to False to skip updating file mtimes (same as yt-dlp --no-mtime)
YDL_UPDATE_TIME=True

# Python logging level for the app logger (DEBUG, INFO, WARNING, ERROR)
YDL_LOG_LEVEL=INFO

# Background update check, off by default: startup makes no network request. When
# enabled the first check is awaited at startup and then runs on the interval (floor
# 60 seconds). Nothing is installed by the check; the result is read by
# GET /youtube-dl/update and shown on the queue page, and installing it stays an
# explicit PUT /youtube-dl/update. A failed check is logged, not reported.
YDL_UPDATE_CHECK=False
YDL_UPDATE_CHECK_INTERVAL=86400
