# Copy to .env or set as environment variables. All values shown are the
# defaults the app already uses, so this file changes nothing by itself.

# yt-dlp format selector
YDL_FORMAT=bestvideo+bestaudio/best

# Set to an audio codec (aac, flac, mp3, m4a, opus, vorbis, wav) to force
# audio extraction; leave empty to use the format selector above.
YDL_EXTRACT_AUDIO_FORMAT=
YDL_EXTRACT_AUDIO_QUALITY=192

# Set to a video container (mp4, flv, webm, ogg, mkv, avi) to force recoding;
# leave empty to use the format selector above.
YDL_RECODE_VIDEO_FORMAT=

YDL_OUTPUT_TEMPLATE=/youtube-dl/%(title).200s [%(id)s].%(ext)s

# Optional yt-dlp download archive file (e.g. /youtube-dl/archive.txt)
# YDL_ARCHIVE_FILE=

# Set to False to skip updating file mtimes (same as yt-dlp --no-mtime)
YDL_UPDATE_TIME=True

# Python logging level for the app logger (DEBUG, INFO, WARNING, ERROR)
YDL_LOG_LEVEL=INFO
